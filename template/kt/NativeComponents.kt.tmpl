@OptIn(ExperimentalMaterial3Api::class)
@Composable
private fun DateDialog(
    request: NativeUiRequest,
    styles: ComponentStyles,
    finish: (String) -> Unit,
) {
    val options = request.options
    val min = parseDate(options.optString("min"))
    val max = parseDate(options.optString("max"))

    val state = rememberDatePickerState(
        initialSelectedDateMillis = parseDate(options.optString("initial")),
        selectableDates = remember(min, max) {
            object : SelectableDates {
                override fun isSelectableDate(utcTimeMillis: Long): Boolean =
                    (min == null || utcTimeMillis >= min) && (max == null || utcTimeMillis <= max)
            }
        },
    )

    PickerDialog(
        styles = styles,
        confirmLabel = options.optString("confirmLabel").ifEmpty { "OK" },
        cancelLabel = options.optString("cancelLabel").ifEmpty { "Cancel" },
        onCancel = { finish("null") },
        onConfirm = {
            val selected = state.selectedDateMillis
            finish(if (selected == null) "null" else jsonString(formatDate(selected)))
        },
    ) {
        DatePicker(
            state = state,
            colors = pickerColors(styles),
            showModeToggle = options.optBoolean("showModeToggle", true),
            title = {
                val title = options.optString("title")
                if (title.isNotEmpty()) {
                    Text(
                        title,
                        color = styles.pickerHeaderTextColor,
                        fontSize = styles.dialogTitleSize,
                        fontWeight = styles.dialogTitleWeight,
                        fontFamily = styles.fontFamily,
                        modifier = Modifier.padding(start = 24.dp, top = 20.dp),
                    )
                }
            },
        )
    }
}

@OptIn(ExperimentalMaterial3Api::class)
@Composable
private fun DateRangeDialog(
