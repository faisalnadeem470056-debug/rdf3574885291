private const val DATE_FORMAT = "yyyy-MM-dd"

private fun utcFormatter(pattern: String) = SimpleDateFormat(pattern, Locale.US).apply {
    // The picker works in UTC midnights; formatting in local time would slide
    // the date by one day for anyone west of Greenwich.
    timeZone = TimeZone.getTimeZone("UTC")
}

private fun parseDate(value: String?): Long? {
    if (value.isNullOrBlank()) return null
    return try {
        utcFormatter(DATE_FORMAT).parse(value)?.time
    } catch (_: Exception) {
        null
    }
}

private fun formatDate(millis: Long): String = utcFormatter(DATE_FORMAT).format(millis)

