/**
 * Resolves the manifest's `components` overrides against the app's palette.
 *
 * [override] is the per-call `style` object, which wins over the manifest, so
 * one screen can use a different-looking dialog without changing the app.
 */
fun resolveComponentStyles(
    values: JSONObject?,
    override: JSONObject?,
    accent: String,
    surface: String,
    // Kept in the signature even though the defaults derive from each
    // component's own surface: a page background is the obvious thing to want
    // here later, and callers already pass it.
    @Suppress("UNUSED_PARAMETER") background: String,
    text: String,
    /**
     * The app bar's own colours. Search and the top tabs live INSIDE the app
     * bar, so they must default to its foreground -- defaulting them to the
     * body text colour put dark query text on a dark app bar.
     */
    appBarBackground: String = surface,
    appBarForeground: String = text,
): ComponentStyles {
    fun raw(key: String): Any? {
        override?.let { if (it.has(key) && !it.isNull(key)) return it.get(key) }
        values?.let { if (it.has(key) && !it.isNull(key)) return it.get(key) }
        return null
    }

    fun colour(key: String, fallback: Color): Color {
        val value = raw(key) as? String ?: return fallback
        return if (value.isEmpty()) fallback else parseHexColor(value, fallback)
    }

    fun size(key: String, fallback: Double): TextUnit {
        val value = (raw(key) as? Number)?.toDouble() ?: fallback
        return value.coerceIn(8.0, 48.0).sp
    }

    fun radius(key: String, fallback: Double): Dp {
        val value = (raw(key) as? Number)?.toDouble() ?: fallback
        return value.coerceIn(0.0, 48.0).dp
    }

    fun weight(key: String, fallback: FontWeight): FontWeight = when (raw(key) as? String) {
        "normal" -> FontWeight.Normal
        "medium" -> FontWeight.Medium
        "semibold" -> FontWeight.SemiBold
        "bold" -> FontWeight.Bold
        else -> fallback
    }

    val accentColor = parseHexColor(accent)
    val surfaceColor = parseHexColor(surface, Color.White)
    val textColor = parseHexColor(text, Color.Black)

    // Text colours derive from the surface they sit on, not from the theme's
    // body colour. Setting only `dialogBackground` to something dark used to
    // leave the title and the Cancel button in near-invisible dark grey, which
    // reads as a bug in the component rather than a missing override.
    fun readableOn(surfaceColour: Color): Color =
        if (surfaceColour.luminance() < 0.5f) Color.White else Color.Black

    val dialogSurface = colour("dialogBackground", surfaceColor)
    val onDialog = readableOn(dialogSurface)
    val sheetSurface = colour("sheetBackground", surfaceColor)
    val onSheet = readableOn(sheetSurface)
    val pickerSurface = colour("pickerBackground", surfaceColor)
    val onPicker = readableOn(pickerSurface)
    val loadingSurface = colour("loadingCardBackground", surfaceColor)
    val inputSurface = colour("inputBackground", dialogSurface)

    // Top tabs sit directly under the app bar and read as part of it.
    val appBarSurface = parseHexColor(appBarBackground, surfaceColor)
    val onAppBar = parseHexColor(appBarForeground, readableOn(appBarSurface))

    return ComponentStyles(
        fontFamily = when (raw("fontFamily") as? String) {
            "serif" -> FontFamily.Serif
            "monospace" -> FontFamily.Monospace
            "sans-serif" -> FontFamily.SansSerif
            "cursive" -> FontFamily.Cursive
            else -> null
        },
        dialogBackground = dialogSurface,
        dialogTitleColor = colour("dialogTitleColor", onDialog),
        dialogTitleSize = size("dialogTitleSize", 20.0),
        dialogTitleWeight = weight("dialogTitleWeight", FontWeight.SemiBold),
        dialogTextColor = colour("dialogTextColor", onDialog.copy(alpha = 0.75f)),
        dialogTextSize = size("dialogTextSize", 14.0),
        dialogTextWeight = weight("dialogTextWeight", FontWeight.Normal),
        dialogButtonColor = colour("dialogButtonColor", accentColor),
        dialogCancelColor = colour("dialogCancelColor", onDialog.copy(alpha = 0.7f)),
        dialogDestructiveColor = colour("dialogDestructiveColor", Color(0xFFD32F2F)),
        dialogButtonSize = size("dialogButtonSize", 14.0),
        dialogButtonWeight = weight("dialogButtonWeight", FontWeight.SemiBold),
        dialogCornerRadius = radius("dialogCornerRadius", 28.0),
        dialogScrim = colour("dialogScrim", Color.Black.copy(alpha = 0.5f)),
        sheetBackground = sheetSurface,
        sheetHandleColor = colour("sheetHandleColor", onSheet.copy(alpha = 0.25f)),
        sheetTitleColor = colour("sheetTitleColor", onSheet.copy(alpha = 0.6f)),
        sheetTitleSize = size("sheetTitleSize", 13.0),
        sheetItemColor = colour("sheetItemColor", onSheet),
        sheetItemSize = size("sheetItemSize", 16.0),
        sheetItemWeight = weight("sheetItemWeight", FontWeight.Normal),
        sheetIconColor = colour("sheetIconColor", onSheet),
        sheetSelectedColor = colour("sheetSelectedColor", accentColor),
        sheetDividerColor = colour("sheetDividerColor", onSheet.copy(alpha = 0.12f)),
        sheetCornerRadius = radius("sheetCornerRadius", 28.0),
        pickerBackground = pickerSurface,
        pickerTextColor = colour("pickerTextColor", onPicker),
        pickerTextSize = size("pickerTextSize", 14.0),
        pickerHeaderBackground = colour("pickerHeaderBackground", pickerSurface),
        pickerHeaderTextColor = colour("pickerHeaderTextColor", onPicker.copy(alpha = 0.75f)),
        pickerSelectedBackground = colour("pickerSelectedBackground", accentColor),
        pickerSelectedTextColor = colour("pickerSelectedTextColor", Color.White),
        pickerTodayColor = colour("pickerTodayColor", accentColor),
        pickerWeekdayColor = colour("pickerWeekdayColor", onPicker.copy(alpha = 0.6f)),
        pickerCornerRadius = radius("pickerCornerRadius", 28.0),
        snackbarBackground = colour("snackbarBackground", Color(0xFF2A2C33)),
        snackbarTextColor = colour("snackbarTextColor", Color.White),
        snackbarActionColor = colour(
            "snackbarActionColor",
            readableOn(accentColor, colour("snackbarBackground", Color(0xFF2A2C33))),
        ),
        snackbarTextSize = size("snackbarTextSize", 14.0),
        snackbarCornerRadius = radius("snackbarCornerRadius", 12.0),
        loadingScrim = colour("loadingScrim", Color.Black.copy(alpha = 0.35f)),
        loadingCardBackground = loadingSurface,
        loadingIndicatorColor = colour("loadingIndicatorColor", accentColor),
        loadingTextColor = colour("loadingTextColor", readableOn(loadingSurface)),
        loadingCornerRadius = radius("loadingCornerRadius", 20.0),
        inputBackground = inputSurface,
        inputTextColor = colour("inputTextColor", readableOn(inputSurface)),
        inputTextSize = size("inputTextSize", 16.0),
        inputBorderColor = colour("inputBorderColor", readableOn(inputSurface).copy(alpha = 0.3f)),
        inputFocusColor = colour("inputFocusColor", accentColor),
        inputCornerRadius = radius("inputCornerRadius", 12.0),
        fabBackground = colour("fabBackground", accentColor),
        fabForeground = colour("fabForeground", readableOn(colour("fabBackground", accentColor))),
        // 16dp is Material's rounded-square FAB; 28 gives the older circle.
        fabCornerRadius = radius("fabCornerRadius", 16.0),
        menuBackground = colour("menuBackground", surfaceColor),
        menuTextColor = colour("menuTextColor", readableOn(colour("menuBackground", surfaceColor))),
        menuTextSize = size("menuTextSize", 15.0),
        menuCornerRadius = radius("menuCornerRadius", 12.0),
        searchTextColor = colour("searchTextColor", onAppBar),
        searchHintColor = colour("searchHintColor", onAppBar.copy(alpha = 0.6f)),
        searchTextSize = size("searchTextSize", 16.0),
        topTabBackground = colour("topTabBackground", appBarSurface),
        topTabSelected = colour("topTabSelected", onAppBar),
        topTabUnselected = colour("topTabUnselected", onAppBar.copy(alpha = 0.6f)),
        topTabIndicator = colour("topTabIndicator", onAppBar),
        topTabTextSize = size("topTabTextSize", 14.0),
        topTabWeight = weight("topTabWeight", FontWeight.SemiBold),
        navIndicatorColor = (raw("navIndicatorColor") as? String)?.takeIf { it.isNotEmpty() }?.let { parseHexColor(it, Color.Transparent) },
        navLabelSize = size("navLabelSize", 12.0),
        navLabelWeight = weight("navLabelWeight", FontWeight.SemiBold),
        navIconSize = ((raw("navIconSize") as? Number)?.toDouble() ?: 24.0).coerceIn(8.0, 48.0).dp,
        appBarTitleSize = if (raw("appBarTitleSize") is Number) size("appBarTitleSize", 22.0) else null,
        appBarTitleWeight = if (raw("appBarTitleWeight") is String) weight("appBarTitleWeight", FontWeight.Normal) else null,
        drawerItemSize = size("drawerItemSize", 14.0),
        drawerItemWeight = weight("drawerItemWeight", FontWeight.Medium),
        drawerCornerRadius = radius("drawerCornerRadius", 16.0),
        navGradientEnd = (raw("navGradientEnd") as? String)?.takeIf { it.isNotEmpty() }?.let { parseHexColor(it, Color.Transparent) },
        navGradientAngle = ((raw("navGradientAngle") as? Number)?.toDouble() ?: 90.0).coerceIn(0.0, 360.0).toFloat(),
        navHeight = (raw("navHeight") as? Number)?.toDouble()?.coerceIn(48.0, 120.0)?.dp,
        navCentreColor = (raw("navCentreColor") as? String)?.takeIf { it.isNotEmpty() }?.let { parseHexColor(it, Color.Transparent) },
        appBarGradientEnd = (raw("appBarGradientEnd") as? String)?.takeIf { it.isNotEmpty() }?.let { parseHexColor(it, Color.Transparent) },
        appBarGradientAngle = ((raw("appBarGradientAngle") as? Number)?.toDouble() ?: 90.0).coerceIn(0.0, 360.0).toFloat(),
        appBarHeight = (raw("appBarHeight") as? Number)?.toDouble()?.coerceIn(48.0, 120.0)?.dp,
        drawerGradientEnd = (raw("drawerGradientEnd") as? String)?.takeIf { it.isNotEmpty() }?.let { parseHexColor(it, Color.Transparent) },
        drawerGradientAngle = ((raw("drawerGradientAngle") as? Number)?.toDouble() ?: 180.0).coerceIn(0.0, 360.0).toFloat(),
        drawerWidth = (raw("drawerWidth") as? Number)?.toDouble()?.coerceIn(200.0, 400.0)?.dp,
    )
}

// ---------------------------------------------------------------------------
// Requests
// ---------------------------------------------------------------------------

/** One `native.*` call waiting on an answer. */
data class NativeUiRequest(val id: Int, val kind: String, val options: JSONObject) {
    /** Per-call style overrides, merged over the manifest's `components`. */
    val style: JSONObject? get() = options.optJSONObject("style")

    companion object {
        fun fromBridge(message: JSONObject): NativeUiRequest? {
            val id = message.optInt("id", -1)
            if (id < 0) return null
            return NativeUiRequest(
                id = id,
                kind = message.optString("kind"),
                options = message.optJSONObject("options") ?: JSONObject(),
            )
        }
    }
}

/** JSON literal for `window.__resolve`. */
private fun jsonString(value: String?): String =
    if (value == null) "null" else JSONObject.quote(value)

// ---------------------------------------------------------------------------
// Host
// ---------------------------------------------------------------------------

/**
 * Renders whichever native component the page asked for.
 *
 * [onResult] hands back the id and a JSON literal; a dismissed component always
 * resolves (with `null` or `false`) so page code never hangs on an await.
 */
@OptIn(ExperimentalMaterial3Api::class)
@Composable
fun NativeComponentHost(
    request: NativeUiRequest?,
    styles: ComponentStyles,
    onResult: (id: Int, resultJson: String) -> Unit,
) {
    if (request == null) return

    val finish = { result: String -> onResult(request.id, result) }

    when (request.kind) {
        "confirm", "alert" -> ConfirmDialog(request, styles, finish)
        "prompt" -> PromptDialog(request, styles, finish)
        "date" -> DateDialog(request, styles, finish)
        "dateRange" -> DateRangeDialog(request, styles, finish)
        "time" -> TimeDialog(request, styles, finish)
        "actionSheet" -> ActionSheet(request, styles, finish)
        "select" -> SelectSheet(request, styles, multi = false, finish = finish)
        "multiSelect" -> SelectSheet(request, styles, multi = true, finish = finish)
        // 'snackbar' is handled by the shell, which owns the SnackbarHostState.
        else -> finish("null")
    }
}

/**
 * The scrim + card every dialog sits in.
 *
 * Deliberately not a platform `Dialog`: its scrim colour cannot be themed, and
 * "make the dim behind the dialog lighter" has to be a change the agent can
 * actually make.
 */
@Composable
private fun DialogSurface(
    styles: ComponentStyles,
    onDismiss: () -> Unit,
    content: @Composable () -> Unit,
) {
    BackHandler(enabled = true) { onDismiss() }

    Box(
        modifier = Modifier
            .fillMaxSize()
            .background(styles.dialogScrim)
            // Tapping outside dismisses, and the indication is suppressed so the
            // scrim does not ripple.
            .clickable(
                interactionSource = remember { MutableInteractionSource() },
                indication = null,
                onClick = onDismiss,
            )
            .imePadding()
            .padding(24.dp),
        contentAlignment = Alignment.Center,
    ) {
        Surface(
            color = styles.dialogBackground,
            shape = RoundedCornerShape(styles.dialogCornerRadius),
            tonalElevation = 0.dp,
            shadowElevation = 8.dp,
            modifier = Modifier
                .widthIn(max = 420.dp)
                // Swallow taps on the card itself, so they do not dismiss.
                .clickable(
                    interactionSource = remember { MutableInteractionSource() },
                    indication = null,
                    onClick = {},
                ),
        ) {
            content()
        }
    }
}

@Composable
private fun DialogTitle(text: String, styles: ComponentStyles) {
    if (text.isEmpty()) return
    Text(
        text = text,
        color = styles.dialogTitleColor,
        fontSize = styles.dialogTitleSize,
        fontWeight = styles.dialogTitleWeight,
        fontFamily = styles.fontFamily,
    )
}

@Composable
private fun DialogButtons(
    styles: ComponentStyles,
    cancelLabel: String?,
    confirmLabel: String,
    confirmColor: Color,
    onCancel: () -> Unit,
    onConfirm: () -> Unit,
) {
    Row(
        modifier = Modifier.fillMaxWidth(),
        horizontalArrangement = Arrangement.End,
    ) {
        if (cancelLabel != null) {
            TextButton(onClick = onCancel) {
                Text(
                    cancelLabel,
                    color = styles.dialogCancelColor,
                    fontSize = styles.dialogButtonSize,
                    fontWeight = styles.dialogButtonWeight,
                    fontFamily = styles.fontFamily,
                )
            }
            Spacer(Modifier.size(4.dp))
        }
        TextButton(onClick = onConfirm) {
            Text(
                confirmLabel,
                color = confirmColor,
                fontSize = styles.dialogButtonSize,
                fontWeight = styles.dialogButtonWeight,
                fontFamily = styles.fontFamily,
            )
        }
    }
}

@Composable
private fun ConfirmDialog(
    request: NativeUiRequest,
    styles: ComponentStyles,
    finish: (String) -> Unit,
) {
    val options = request.options
    val isAlert = request.kind == "alert"
    val destructive = options.optBoolean("destructive", false)

    DialogSurface(styles, onDismiss = { finish(if (isAlert) "true" else "false") }) {
        Column(Modifier.padding(24.dp)) {
            DialogTitle(options.optString("title"), styles)

            val message = options.optString("message")
            if (message.isNotEmpty()) {
                Spacer(Modifier.height(10.dp))
                Text(
                    message,
                    color = styles.dialogTextColor,
                    fontSize = styles.dialogTextSize,
                    fontWeight = styles.dialogTextWeight,
                    fontFamily = styles.fontFamily,
                )
            }

            Spacer(Modifier.height(18.dp))
            DialogButtons(
                styles = styles,
                cancelLabel = if (isAlert) {
                    null
                } else {
                    options.optString("cancelLabel").ifEmpty { "Cancel" }
                },
                confirmLabel = options.optString("confirmLabel").ifEmpty { "OK" },
                confirmColor = if (destructive) {
                    styles.dialogDestructiveColor
                } else {
                    styles.dialogButtonColor
                },
                onCancel = { finish("false") },
                onConfirm = { finish("true") },
            )
        }
    }
}

@Composable
private fun PromptDialog(
    request: NativeUiRequest,
    styles: ComponentStyles,
    finish: (String) -> Unit,
) {
    val options = request.options
    // TextFieldValue cannot go into a Bundle on its own, so it needs its
    // Saver: without it, opening the prompt crashes the app outright.
    var value by rememberSaveable(request.id, stateSaver = TextFieldValue.Saver) {
        mutableStateOf(TextFieldValue(options.optString("value")))
    }
    val focus = remember { FocusRequester() }

    // The keyboard should be up already: a prompt exists to be typed into.
    LaunchedEffect(request.id) { focus.requestFocus() }

    DialogSurface(styles, onDismiss = { finish("null") }) {
        Column(Modifier.padding(24.dp)) {
            DialogTitle(options.optString("title"), styles)

            val message = options.optString("message")
            if (message.isNotEmpty()) {
                Spacer(Modifier.height(8.dp))
                Text(
                    message,
                    color = styles.dialogTextColor,
                    fontSize = styles.dialogTextSize,
                    fontFamily = styles.fontFamily,
                )
            }

            Spacer(Modifier.height(14.dp))
            OutlinedTextField(
                value = value,
                onValueChange = { value = it },
                singleLine = !options.optBoolean("multiline", false),
                shape = RoundedCornerShape(styles.inputCornerRadius),
                textStyle = TextStyle(
                    color = styles.inputTextColor,
                    fontSize = styles.inputTextSize,
