/** The themed snackbar, used by both `native.toast` and `native.snackbar`. */
@Composable
fun StyledSnackbar(data: SnackbarData, styles: ComponentStyles) {
    Snackbar(
        snackbarData = data,
        containerColor = styles.snackbarBackground,
        contentColor = styles.snackbarTextColor,
        actionColor = styles.snackbarActionColor,
        shape = RoundedCornerShape(styles.snackbarCornerRadius),
    )
}

/**
 * Applies the window-level parts of a screen's spec: orientation lock, full
 * screen, and the system bar colours.
 *
 * These are properties of the Activity's window rather than of anything drawn,
 * so they are set as an effect and put back when the screen goes away -- a
 * landscape-locked screen that leaves the whole app locked is a bug the user
 * cannot escape.
 */
@Composable
fun ApplyScreenWindowEffects(
    orientation: String,
    fullScreen: Boolean,
    statusBarColor: Color,
    navigationBarColor: Color,
) {
    val context = LocalContext.current
    val activity = context.findActivity() ?: return

    DisposableEffect(orientation) {
        val previous = activity.requestedOrientation
        activity.requestedOrientation = when (orientation) {
            "portrait" -> ActivityInfo.SCREEN_ORIENTATION_PORTRAIT
            "landscape" -> ActivityInfo.SCREEN_ORIENTATION_LANDSCAPE
            else -> ActivityInfo.SCREEN_ORIENTATION_UNSPECIFIED
        }
        onDispose { activity.requestedOrientation = previous }
    }

    DisposableEffect(fullScreen) {
        val window = activity.window
        val controller = WindowCompat.getInsetsController(window, window.decorView)

        if (fullScreen) {
            controller.systemBarsBehavior =
                WindowInsetsControllerCompat.BEHAVIOR_SHOW_TRANSIENT_BARS_BY_SWIPE
            controller.hide(WindowInsetsCompat.Type.systemBars())
        } else {
            controller.show(WindowInsetsCompat.Type.systemBars())
        }

        onDispose { controller.show(WindowInsetsCompat.Type.systemBars()) }
    }

    DisposableEffect(statusBarColor, navigationBarColor) {
        val window = activity.window
        val controller = WindowCompat.getInsetsController(window, window.decorView)

        @Suppress("DEPRECATION")
        val previousStatus = window.statusBarColor
        @Suppress("DEPRECATION")
        val previousNav = window.navigationBarColor

        @Suppress("DEPRECATION")
        window.statusBarColor = statusBarColor.toArgb()
        @Suppress("DEPRECATION")
        window.navigationBarColor = navigationBarColor.toArgb()

        // Dark icons on a light bar, and the reverse: a white status bar with
        // white icons shows nothing at all.
        controller.isAppearanceLightStatusBars = statusBarColor.luminance() > 0.5f
        controller.isAppearanceLightNavigationBars = navigationBarColor.luminance() > 0.5f

        onDispose {
            @Suppress("DEPRECATION")
            window.statusBarColor = previousStatus
            @Suppress("DEPRECATION")
            window.navigationBarColor = previousNav
        }
    }
}

/** Blocking progress overlay, shown while `native.loading(true)` is in force. */
@Composable
fun NativeLoadingOverlay(message: String?, styles: ComponentStyles) {
    // Swallows back presses too: the point of a blocking overlay is that the
    // work in flight cannot be interrupted halfway.
    BackHandler(enabled = true) {}

    Box(
        modifier = Modifier
            .fillMaxSize()
            .background(styles.loadingScrim)
            .clickable(
                interactionSource = remember { MutableInteractionSource() },
                indication = null,
                onClick = {},
            ),
        contentAlignment = Alignment.Center,
    ) {
        Surface(
            color = styles.loadingCardBackground,
            shape = RoundedCornerShape(styles.loadingCornerRadius),
            shadowElevation = 6.dp,
        ) {
            Column(
                modifier = Modifier.padding(horizontal = 28.dp, vertical = 24.dp),
                horizontalAlignment = Alignment.CenterHorizontally,
            ) {
                CircularProgressIndicator(
                    color = styles.loadingIndicatorColor,
                    strokeWidth = 3.dp,
                    modifier = Modifier.size(34.dp),
                )
                if (!message.isNullOrEmpty()) {
                    Spacer(Modifier.height(14.dp))
                    Text(
                        message,
                        color = styles.loadingTextColor,
                        fontSize = styles.dialogTextSize,
                        fontFamily = styles.fontFamily,
                    )
                }
            }
        }
    }
}

/**
 * [color], nudged toward white (on a dark background) or black (on a light
 * one) until it reads clearly on [background]: WCAG contrast 4.5. A theme
 * accent is often too dark for the dark snackbar, which made its action
 * button unreadable.
 */
internal fun readableOn(color: Color, background: Color): Color {
    fun contrast(a: Color, b: Color): Float {
        val la = a.luminance() + 0.05f
        val lb = b.luminance() + 0.05f
        return if (la > lb) la / lb else lb / la
    }
    val towards = if (background.luminance() < 0.5f) Color.White else Color.Black
    var result = color
    var t = 0f
    while (contrast(result, background) < 4.5f && t < 0.9f) {
        t += 0.1f
        result = lerp(color, towards, t)
    }
    return result
}
