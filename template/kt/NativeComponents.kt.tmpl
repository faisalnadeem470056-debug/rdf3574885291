@OptIn(ExperimentalMaterial3Api::class)
@Composable
private fun ActionSheet(
    request: NativeUiRequest,
    styles: ComponentStyles,
    finish: (String) -> Unit,
) {
    val items = request.options.optJSONArray("items") ?: JSONArray()

    SheetSurface(styles, onDismiss = { finish("null") }) {
        SheetTitle(request.options.optString("title"), styles)

        for (index in 0 until items.length()) {
            val item = items.optJSONObject(index) ?: continue
            if (item.optBoolean("divider", false)) {
                HorizontalDivider(
                    color = styles.sheetDividerColor,
                    modifier = Modifier.padding(vertical = 6.dp),
                )
                continue
            }

            val destructive = item.optBoolean("destructive", false)
            val colour = if (destructive) styles.dialogDestructiveColor else styles.sheetItemColor

            SheetRow(onClick = { finish(jsonString(item.optString("id"))) }) {
                val icon = item.optString("icon")
                if (icon.isNotEmpty()) {
                    Icon(
                        materialIcon(icon),
                        contentDescription = null,
                        tint = if (destructive) colour else styles.sheetIconColor,
                        modifier = Modifier.size(22.dp),
                    )
                    Spacer(Modifier.size(16.dp))
                }
                Text(
                    item.optString("label"),
                    color = colour,
                    fontSize = styles.sheetItemSize,
                    fontWeight = styles.sheetItemWeight,
                    fontFamily = styles.fontFamily,
                )
            }
        }
    }
}

@OptIn(ExperimentalMaterial3Api::class)
@Composable
private fun SelectSheet(
    request: NativeUiRequest,
    styles: ComponentStyles,
    multi: Boolean,
    finish: (String) -> Unit,
) {
    val options = request.options.optJSONArray("options") ?: JSONArray()

    val initial = remember(request.id) {
        val selected = ArrayList<String>()
        if (multi) {
            val array = request.options.optJSONArray("selected") ?: JSONArray()
            for (i in 0 until array.length()) selected.add(array.optString(i))
        } else {
            request.options.optString("selected")
                .takeIf { it.isNotEmpty() }
                ?.let { selected.add(it) }
        }
        selected
    }
    val chosen: SnapshotStateList<String> = remember(request.id) { initial.toMutableStateList() }

    SheetSurface(styles, onDismiss = { finish("null") }) {
        SheetTitle(request.options.optString("title"), styles)

        LazyColumn(
            contentPadding = PaddingValues(bottom = 4.dp),
            modifier = Modifier.heightIn(max = 420.dp),
        ) {
            items(options.length()) { index ->
                val option = options.optJSONObject(index)
                val value = option?.optString("value") ?: options.optString(index)
                val label = option?.optString("label")?.ifEmpty { value } ?: value
                val isSelected = chosen.contains(value)

                SheetRow(
                    onClick = {
                        if (!multi) {
                            finish(jsonString(value))
                        } else if (isSelected) {
                            chosen.remove(value)
                        } else {
                            chosen.add(value)
                        }
                    },
                ) {
                    if (multi) {
                        Checkbox(
                            checked = isSelected,
                            onCheckedChange = null,
                            colors = CheckboxDefaults.colors(
                                checkedColor = styles.sheetSelectedColor,
                                uncheckedColor = styles.sheetItemColor.copy(alpha = 0.5f),
                                checkmarkColor = styles.dialogBackground,
                            ),
                        )
                        Spacer(Modifier.size(12.dp))
                    } else {
                        val icon = option?.optString("icon").orEmpty()
                        if (icon.isNotEmpty()) {
                            Icon(
                                materialIcon(icon),
                                contentDescription = null,
                                tint = styles.sheetIconColor,
                                modifier = Modifier.size(22.dp),
                            )
                            Spacer(Modifier.size(16.dp))
                        }
                    }

                    Text(
                        label,
                        color = if (isSelected && !multi) {
                            styles.sheetSelectedColor
                        } else {
                            styles.sheetItemColor
                        },
                        fontSize = styles.sheetItemSize,
                        fontWeight = styles.sheetItemWeight,
                        fontFamily = styles.fontFamily,
                        modifier = Modifier.weight(1f),
                    )

                    if (isSelected && !multi) {
                        Icon(
                            Icons.Filled.Check,
                            contentDescription = null,
                            tint = styles.sheetSelectedColor,
                            modifier = Modifier.size(20.dp),
                        )
                    }
                }
            }
        }

        if (multi) {
            HorizontalDivider(color = styles.sheetDividerColor)
            Row(
                modifier = Modifier.fillMaxWidth().padding(12.dp),
                horizontalArrangement = Arrangement.End,
            ) {
                TextButton(onClick = { finish("null") }) {
                    Text(
                        request.options.optString("cancelLabel").ifEmpty { "Cancel" },
                        color = styles.dialogCancelColor,
                        fontSize = styles.dialogButtonSize,
                        fontWeight = styles.dialogButtonWeight,
                        fontFamily = styles.fontFamily,
                    )
                }
                TextButton(
                    onClick = {
                        val array = JSONArray()
                        chosen.forEach { array.put(it) }
                        finish(array.toString())
                    },
                ) {
                    Text(
                        request.options.optString("confirmLabel").ifEmpty { "Done" },
                        color = styles.dialogButtonColor,
                        fontSize = styles.dialogButtonSize,
                        fontWeight = styles.dialogButtonWeight,
                        fontFamily = styles.fontFamily,
                    )
                }
            }
        }
    }
}

