package {{PACKAGE}}

import android.content.Intent
import android.os.Bundle
import androidx.activity.compose.setContent
{{ACTIVITY_IMPORT}}
import androidx.activity.enableEdgeToEdge
import androidx.compose.foundation.isSystemInDarkTheme
import androidx.compose.material3.MaterialTheme
import androidx.compose.material3.darkColorScheme
import androidx.compose.material3.lightColorScheme
import androidx.compose.runtime.getValue
import androidx.compose.runtime.produceState
import androidx.compose.ui.graphics.Color

/**
 * {{APP_NAME}} -- generated by AI App Builder.
 *
 * The app bar, bottom tabs and side menu are real native widgets; only the body
 * of each screen is web content, served from `assets/www` over a loopback HTTP
 * origin (a `file://` origin cannot load ES modules).
 */
/**
 * The base class depends on what this app declared: BiometricPrompt attaches a
 * fragment to its host and needs a FragmentActivity, so an app using biometric
 * gets one -- and every other app gets the lighter ComponentActivity, with no
 * androidx.fragment dependency at all.
 */
class MainActivity : {{ACTIVITY_BASE}}() {

    private lateinit var server: AssetServer

    override fun onCreate(savedInstanceState: Bundle?) {
        super.onCreate(savedInstanceState)

        // The heads-up channel exists before any push can arrive, and the
        // app's push provider (Firebase or OneSignal), if it has one, starts.
        ensureAlertChannel(this)
        try {
            val push = Class.forName("$packageName.PushSupport").getDeclaredField("INSTANCE").get(null)
            push.javaClass.getMethod("init", android.content.Context::class.java).invoke(push, applicationContext)
        } catch (_: Throwable) {
            // No push in this app.
        }

        // Launched by tapping a notification: the payload waits in the bus
        // until a screen is composed and can receive the event.
        NotificationBus.fromIntent(intent)?.let { NotificationBus.deliver(it) }
        enableEdgeToEdge()

        val storage = AppStorage.open(this)
        server = AssetServer(this, storage)

        val manifest = AppManifest.parse(
            assets.open("www/project.json").use { it.readBytes().toString(Charsets.UTF_8) },
        )

        setContent {
            val accent = parseHexColor(manifest.theme.accent)
            val dark = when (manifest.theme.mode) {
                "dark" -> true
                "light" -> false
                else -> isSystemInDarkTheme()
            }

            MaterialTheme(
                colorScheme = if (dark) {
                    darkColorScheme(primary = accent, background = Color(0xFF121316))
                } else {
                    lightColorScheme(primary = accent, onPrimary = Color.White)
                },
            ) {
                // The shell needs the server's port, so it waits for the bind
                // rather than guessing the preferred one.
                val started by produceState(initialValue = false) {
                    server.start()
                    value = true
                }

                if (started) AppShell(manifest = manifest, server = server, storage = storage)
            }
        }
    }

    /** Tapped while the app was already running. */
    override fun onNewIntent(intent: Intent) {
        super.onNewIntent(intent)
        setIntent(intent)
        NotificationBus.fromIntent(intent)?.let { NotificationBus.deliver(it) }
        DeepLinkBus.fromIntent(intent)?.let { DeepLinkBus.deliver(it) }
    }

    override fun onDestroy() {
        server.stop()
        super.onDestroy()
    }
}
