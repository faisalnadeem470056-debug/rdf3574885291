        ),
        NativeCapability(
            id = "ads",
            manifestPermissions = emptyList(),
            dependencies = listOf("com.google.android.gms:play-services-ads:23.6.0"),
            adapter = "AdsSupport",
            description = "AdMob banner, interstitial and rewarded ads. Configure with set_ads.",
        ),
    )

    val IDS: List<String> = ALL.map { it.id }

    fun byId(id: String): NativeCapability? = ALL.firstOrNull { it.id == id }

    /**
     * `<uses-permission>` lines for a set of capability ids, deduplicated and
     * sorted so the generated manifest is stable between exports.
     */
    /** Gradle lines for the declared capabilities, deduplicated. */
    fun dependencyLines(ids: Collection<String>): List<String> =
        ids.mapNotNull { byId(it) }
            .flatMap { it.dependencies }
            .distinct()
            .sorted()
            .map { "    implementation(\"$it\")" }

    /** Adapters to emit, one per declared capability that has one. */
    fun adapters(ids: Collection<String>): List<String> =
        ids.mapNotNull { byId(it)?.adapter }.distinct()

    /** BiometricPrompt is the only thing that forces a FragmentActivity host. */
    fun needsFragmentActivity(ids: Collection<String>): Boolean =
        ids.mapNotNull { byId(it) }.any { it.needsFragmentActivity }

    fun manifestLines(ids: Collection<String>): List<String> {
        val lines = sortedSetOf<String>()
        for (id in ids) {
            val capability = byId(id) ?: continue
            for (permission in capability.manifestPermissions) {
                val attributes = StringBuilder("android:name=\"$permission\"")
                capability.maxSdk?.let { attributes.append(" android:maxSdkVersion=\"$it\"") }
                lines.add("    <uses-permission $attributes/>")
            }
        }
        return lines.toList()
    }
}

/** What a page gets back when it asks about a permission. */
enum class PermissionState { GRANTED, DENIED, UNAVAILABLE }

/**
 * Asks for the dangerous permissions a capability needs, at the moment the
 * feature is used rather than at start-up.
 */
class NativePermissionController internal constructor(
    private val context: Context,
    private val request: (List<String>, (Boolean) -> Unit) -> Unit,
) {

    /**
     * Whether the running app declares [permission] at all. A request for
     * something the manifest does not declare is denied instantly by the
     * platform, so it is worth telling the difference.
     */
    fun isDeclared(permission: String): Boolean = try {
        val info = context.packageManager.getPackageInfo(
            context.packageName,
            PackageManager.GET_PERMISSIONS,
        )
        info.requestedPermissions?.contains(permission) == true
    } catch (_: Exception) {
        false
    }

    fun isGranted(permission: String): Boolean =
        ContextCompat.checkSelfPermission(context, permission) == PackageManager.PERMISSION_GRANTED

    fun state(capabilityId: String): PermissionState {
        val capability = NativeCapabilities.byId(capabilityId) ?: return PermissionState.UNAVAILABLE

        val needed = capability.runtimePermissions.filter { isDeclared(it) }
        if (capability.runtimePermissions.isNotEmpty() && needed.isEmpty()) {
            // Declared by nobody: the feature cannot work in this build.
            return PermissionState.UNAVAILABLE
        }
        if (needed.isEmpty()) return PermissionState.GRANTED

        // Location asks for fine and coarse together; either one counts.
        return if (needed.any { isGranted(it) }) PermissionState.GRANTED else PermissionState.DENIED
    }

    /**
     * Runs [onResult] with true once every permission the capability needs is
     * granted. Already-granted capabilities do not prompt.
     */
    fun ensure(capabilityId: String, onResult: (Boolean) -> Unit) {
        val capability = NativeCapabilities.byId(capabilityId)
        if (capability == null) {
            onResult(false)
            return
        }

        val needed = capability.runtimePermissions
            .filter { isDeclared(it) }
            .filterNot { isGranted(it) }
            .filter { Build.VERSION.SDK_INT >= capability.minSdk }

        if (needed.isEmpty()) {
            // Either nothing to ask for, or the app never declared it -- in
            // which case the feature runs without the permission (a camera
            // intent, for instance) rather than being blocked on a prompt that
            // can only fail.
            onResult(true)
            return
        }

        request(needed, onResult)
    }
}

@Composable
fun rememberNativePermissions(): NativePermissionController {
    val context = LocalContext.current
    val callback = remember { arrayOfNulls<(Boolean) -> Unit>(1) }

    val launcher = rememberLauncherForActivityResult(
        ActivityResultContracts.RequestMultiplePermissions(),
    ) { results ->
        val done = callback[0]
        callback[0] = null
        // Any granted is enough: the only multi-permission capability is
        // location, where coarse alone is still a usable answer.
        done?.invoke(results.values.any { it })
    }

    return remember(context) {
        NativePermissionController(context) { permissions, done ->
            callback[0]?.invoke(false)
            callback[0] = done
            launcher.launch(permissions.toTypedArray())
        }
    }
}

/** Answer for `native.requestPermission` / `native.permissionStatus`. */
fun permissionResultJson(state: PermissionState): String = JSONObject()
    .put("granted", state == PermissionState.GRANTED)
    .put(
        "status",
        when (state) {
            PermissionState.GRANTED -> "granted"
            PermissionState.DENIED -> "denied"
            PermissionState.UNAVAILABLE -> "unavailable"
        },
    )
    .toString()

/** The hosting Activity, needed for anything that shows a system prompt. */
fun Context.findActivity(): Activity? {
    var current = this
    while (current is ContextWrapper) {
        if (current is Activity) return current
        current = current.baseContext
    }
    return null
}
