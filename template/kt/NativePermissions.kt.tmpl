package {{PACKAGE}}

// ---------------------------------------------------------------------------
// SHARED FILE -- copied into every export as
// assets/export/kt/NativePermissions.kt.tmpl with only the package line
// swapped (tools/sync_export_templates.sh).
//
// One table maps a capability ("camera", "location", ...) to the permissions
// it needs. THREE things read it, which is the whole point of having it in one
// place:
//
//   * the exporter, to write <uses-permission> lines into the generated
//     AndroidManifest.xml -- a permission that is not declared cannot be
//     granted at runtime, it just fails;
//   * this controller, to ask for the dangerous ones at the moment the feature
//     is used;
//   * the agent's set_permissions tool, to validate what it is asked for.
//
// Adding a capability means adding a row here and nothing else.
// ---------------------------------------------------------------------------

import android.app.Activity
import android.content.Context
import android.content.ContextWrapper
import android.content.pm.PackageManager
import android.os.Build
import androidx.activity.compose.rememberLauncherForActivityResult
import androidx.activity.result.contract.ActivityResultContracts
import androidx.compose.runtime.Composable
import androidx.compose.runtime.remember
import androidx.compose.ui.platform.LocalContext
import androidx.core.content.ContextCompat
import org.json.JSONObject

/** One thing an app can do, and what the platform demands before it can. */
data class NativeCapability(
    val id: String,
    /** Goes into AndroidManifest.xml. Without it, a runtime request is refused outright. */
    val manifestPermissions: List<String>,
    /**
     * The subset that is "dangerous" and has to be granted by the user at
     * runtime. Empty means declaring it is enough.
     */
    val runtimePermissions: List<String> = manifestPermissions,
    /** Only declared from this API level up (e.g. POST_NOTIFICATIONS is 33+). */
    val minSdk: Int = 0,
    /** Only declared up to this API level, written as android:maxSdkVersion. */
    val maxSdk: Int? = null,
    /**
     * Gradle coordinates the exported app needs for this capability, and the
     * builder does not. Everything here is reached through an adapter that
     * ships only with the capability, so nothing links against it otherwise.
     */
    val dependencies: List<String> = emptyList(),
    /**
     * The adapter emitted into the export for this capability, from
     * assets/export/kt-optional/. Reached by reflection from the shared code.
     */
    val adapter: String? = null,
    /** True when the capability needs a FragmentActivity host. */
    val needsFragmentActivity: Boolean = false,
    val description: String,
)

