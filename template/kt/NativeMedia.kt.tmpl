package {{PACKAGE}}

// ---------------------------------------------------------------------------
// SHARED FILE -- copied into every export as assets/export/kt/NativeMedia.kt.tmpl
// with only the package line swapped (tools/sync_export_templates.sh).
//
// Media, files and sharing: the image picker, the camera, the document picker,
// "save a copy", the system share sheet and opening an external link. All of
// them are Activity results, so they live in a controller that owns the
// launchers and answers the page through the same promise channel the dialogs
// use.
//
// Images are downscaled and re-encoded before they ever reach page code: a
// 12MP camera photo as a base64 data URL is ~8MB of string, which would blow
// up both the WebView and anything the page tries to store.
// ---------------------------------------------------------------------------

import android.content.ActivityNotFoundException
import android.content.Context
import android.content.Intent
import android.graphics.Bitmap
import android.graphics.BitmapFactory
import android.net.Uri
import android.provider.OpenableColumns
import android.util.Base64
import android.webkit.ValueCallback
import androidx.activity.compose.rememberLauncherForActivityResult
import androidx.activity.result.PickVisualMediaRequest
import androidx.activity.result.contract.ActivityResultContracts
import androidx.compose.runtime.Composable
import androidx.compose.runtime.remember
import androidx.compose.runtime.rememberCoroutineScope
import androidx.compose.ui.platform.LocalContext
import androidx.core.content.FileProvider
import kotlinx.coroutines.CoroutineScope
import kotlinx.coroutines.Dispatchers
import kotlinx.coroutines.launch
import kotlinx.coroutines.withContext
import org.json.JSONArray
import org.json.JSONObject
import java.io.ByteArrayOutputStream
import java.io.File

/** The `native.*` calls this controller answers. */
private val MEDIA_KINDS = setOf(
    "pickImage",
    "pickImages",
    "pickFile",
    "saveFile",
    "share",
    "openUrl",
)

/**
 * Owns the Activity-result launchers for everything in Tier 2.
 *
 * One instance per shell; [start] takes a request off the bridge and [handles]
 * says whether it is one of ours, so the dialog host never sees it.
 */
class NativeMediaController internal constructor(
    private val context: Context,
    private val scope: CoroutineScope,
    private val onResult: (id: Int, resultJson: String) -> Unit,
    private val launchPickImage: (NativeUiRequest) -> Unit,
    private val launchPickImages: (NativeUiRequest) -> Unit,
    private val launchCamera: (NativeUiRequest) -> Unit,
    private val launchPickFile: (NativeUiRequest) -> Unit,
    private val launchSaveFile: (NativeUiRequest) -> Unit,
    private val launchFileChooser: (ValueCallback<Array<Uri>>, String) -> Unit,
) {

    fun handles(kind: String): Boolean = kind in MEDIA_KINDS

    fun start(request: NativeUiRequest) {
        when (request.kind) {
            "pickImage" ->
                if (request.options.optString("source") == "camera") {
                    launchCamera(request)
                } else {
                    launchPickImage(request)
                }

            "pickImages" -> launchPickImages(request)
            "pickFile" -> launchPickFile(request)
            "saveFile" -> launchSaveFile(request)
            "share" -> share(request)
            "openUrl" -> openUrl(request)
            else -> onResult(request.id, "null")
        }
    }

    /**
     * `<input type="file">` inside a screen. Without this the input is inert:
     * Chromium has no way to open a picker from a WebView on its own.
     */
    fun openFileChooser(callback: ValueCallback<Array<Uri>>, mimeType: String) {
        launchFileChooser(callback, mimeType)
    }

    private fun share(request: NativeUiRequest) {
        val options = request.options
        scope.launch {
            val intent = Intent(Intent.ACTION_SEND)

            val file = options.optJSONObject("file")
            if (file != null) {
                val uri = withContext(Dispatchers.IO) { cacheFile(context, file) }
                if (uri == null) {
                    onResult(request.id, "false")
                    return@launch
                }
                intent.type = file.optString("mimeType")
                    .ifEmpty { guessMimeType(file.optString("name")) }
                intent.putExtra(Intent.EXTRA_STREAM, uri)
                intent.addFlags(Intent.FLAG_GRANT_READ_URI_PERMISSION)
            } else {
                intent.type = "text/plain"
            }

            val text = listOf(options.optString("text"), options.optString("url"))
                .filter { it.isNotEmpty() }
                .joinToString("\n")
            if (text.isNotEmpty()) intent.putExtra(Intent.EXTRA_TEXT, text)

            val title = options.optString("title")
            if (title.isNotEmpty()) intent.putExtra(Intent.EXTRA_SUBJECT, title)

            val chooser = Intent.createChooser(intent, title.ifEmpty { "Share" })
            // The shell is not always an Activity context by the time this runs.
            chooser.addFlags(Intent.FLAG_ACTIVITY_NEW_TASK)

            onResult(request.id, if (startSafely(chooser)) "true" else "false")
        }
    }

    private fun openUrl(request: NativeUiRequest) {
        val url = request.options.optString("url")
        if (url.isEmpty()) {
            onResult(request.id, "false")
            return
        }

        val intent = Intent(Intent.ACTION_VIEW, Uri.parse(url))
        intent.addFlags(Intent.FLAG_ACTIVITY_NEW_TASK)
        onResult(request.id, if (startSafely(intent)) "true" else "false")
    }

    private fun startSafely(intent: Intent): Boolean = try {
        context.startActivity(intent)
        true
    } catch (_: ActivityNotFoundException) {
        // Nothing installed can handle it -- a real answer for the page, not a
        // crash.
        false
    }
}

/**
 * Registers the launchers and returns the controller.
 *
 * [onResult] is the same resolver the dialogs use, so a cancelled picker
 * resolves with null rather than leaving the page awaiting forever.
 */
@Composable
fun rememberNativeMedia(
    permissions: NativePermissionController,
    onResult: (id: Int, resultJson: String) -> Unit,
): NativeMediaController {
    val context = LocalContext.current
    val scope = rememberCoroutineScope()

    // Which request each launcher is currently serving. Plain holders rather
    // than state: nothing in the UI depends on them, and a recomposition in
    // between must not lose them.
    val pendingImage = remember { arrayOfNulls<NativeUiRequest>(1) }
    val pendingImages = remember { arrayOfNulls<NativeUiRequest>(1) }
    val pendingCamera = remember { arrayOfNulls<NativeUiRequest>(1) }
    val pendingFile = remember { arrayOfNulls<NativeUiRequest>(1) }
    val pendingSave = remember { arrayOfNulls<NativeUiRequest>(1) }
    val cameraTarget = remember { arrayOfNulls<Uri>(1) }
    val chooserCallback = remember { arrayOfNulls<ValueCallback<Array<Uri>>>(1) }

    fun finish(request: NativeUiRequest?, json: String) {
        request?.let { onResult(it.id, json) }
    }

    val pickImage = rememberLauncherForActivityResult(
        ActivityResultContracts.PickVisualMedia(),
    ) { uri ->
        val request = pendingImage[0]
        pendingImage[0] = null
        scope.launch {
            finish(request, if (uri == null) "null" else imageJson(context, uri, request))
        }
    }

    val pickImages = rememberLauncherForActivityResult(
        ActivityResultContracts.PickMultipleVisualMedia(MAX_IMAGES),
    ) { uris ->
        val request = pendingImages[0]
        pendingImages[0] = null
        scope.launch {
            if (uris.isNullOrEmpty()) {
                finish(request, "null")
                return@launch
            }
            val max = request?.options?.optInt("max", MAX_IMAGES) ?: MAX_IMAGES
            val array = JSONArray()
            for (uri in uris.take(max.coerceIn(1, MAX_IMAGES))) {
                // One unreadable image (an odd format, a revoked permission)
                // must not lose the whole selection, and "null" is not an
                // object -- parsing it blindly took the app down.
                val json = imageJson(context, uri, request)
                if (json == "null") continue
                try {
                    array.put(JSONObject(json))
                } catch (_: Exception) {
                    continue
                }
            }
            finish(request, if (array.length() == 0) "null" else array.toString())
        }
    }

    val takePicture = rememberLauncherForActivityResult(
        ActivityResultContracts.TakePicture(),
    ) { success ->
        val request = pendingCamera[0]
        val uri = cameraTarget[0]
        pendingCamera[0] = null
        cameraTarget[0] = null
        scope.launch {
            finish(
                request,
                if (!success || uri == null) "null" else imageJson(context, uri, request),
            )
        }
    }

    val openDocument = rememberLauncherForActivityResult(
        ActivityResultContracts.OpenDocument(),
    ) { uri ->
        val request = pendingFile[0]
        pendingFile[0] = null
        scope.launch {
            finish(request, if (uri == null) "null" else fileJson(context, uri, request))
        }
    }

    val createDocument = rememberLauncherForActivityResult(
        ActivityResultContracts.CreateDocument("*/*"),
    ) { uri ->
        val request = pendingSave[0]
        pendingSave[0] = null
        scope.launch {
            if (uri == null || request == null) {
                finish(request, "false")
                return@launch
            }
            val written = withContext(Dispatchers.IO) {
                try {
                    context.contentResolver.openOutputStream(uri)?.use { output ->
                        output.write(payloadBytes(request.options))
                    }
                    true
                } catch (_: Exception) {
                    false
                }
            }
            finish(request, if (written) "true" else "false")
        }
    }

    // For <input type="file"> inside a page, where the mime type is only known
    // when the input is tapped.
    val getContent = rememberLauncherForActivityResult(
        ActivityResultContracts.GetContent(),
    ) { uri ->
        val callback = chooserCallback[0]
        chooserCallback[0] = null
        callback?.onReceiveValue(if (uri == null) null else arrayOf(uri))
    }

    return remember(onResult) {
        NativeMediaController(
            context = context,
            scope = scope,
            onResult = onResult,
            launchPickImage = { request ->
                pendingImage[0] = request
                pickImage.launch(
                    PickVisualMediaRequest(ActivityResultContracts.PickVisualMedia.ImageOnly),
                )
            },
            launchPickImages = { request ->
                pendingImages[0] = request
                pickImages.launch(
                    PickVisualMediaRequest(ActivityResultContracts.PickVisualMedia.ImageOnly),
                )
            },
            launchCamera = { request ->
                // Prompt first: an app that declares CAMERA is refused the
                // capture intent until the permission is actually granted.
                permissions.ensure("camera") { granted ->
                    if (!granted) {
                        onResult(request.id, "null")
                        return@ensure
                    }
                    launchCameraCapture(context, request, pendingCamera, cameraTarget, takePicture)
                }
            },
            launchPickFile = { request ->
                pendingFile[0] = request
                val accept = request.options.optJSONArray("accept")
                val types = if (accept == null || accept.length() == 0) {
                    arrayOf("*/*")
                } else {
                    Array(accept.length()) { accept.optString(it) }
                }
                openDocument.launch(types)
            },
            launchSaveFile = { request ->
                pendingSave[0] = request
                createDocument.launch(
                    request.options.optString("name").ifEmpty { "export.txt" },
                )
            },
            launchFileChooser = { callback, mimeType ->
                chooserCallback[0]?.onReceiveValue(null)
                chooserCallback[0] = callback
                getContent.launch(mimeType.ifEmpty { "*/*" })
            },
        )
    }
}

/** Creates the target file, hands it to the camera app and remembers it. */
private fun launchCameraCapture(
    context: Context,
    request: NativeUiRequest,
    pendingCamera: Array<NativeUiRequest?>,
    cameraTarget: Array<Uri?>,
    takePicture: androidx.activity.result.ActivityResultLauncher<Uri>,
) {
    val file = File(
        File(context.cacheDir, "camera").also { it.mkdirs() },
        "capture_${System.currentTimeMillis()}.jpg",
    )
    val uri = FileProvider.getUriForFile(
        context,
        context.packageName + ".fileprovider",
        file,
    )
    pendingCamera[0] = request
    cameraTarget[0] = uri
    takePicture.launch(uri)
}

// ---------------------------------------------------------------------------
// Encoding
// ---------------------------------------------------------------------------

/** Long edge cap. Big enough to show full-width, small enough to keep in JSON. */
private const val DEFAULT_MAX_SIZE = 1024

private const val DEFAULT_QUALITY = 80

/** Multi-pick ceiling; anything more is a gallery, not an attachment. */
private const val MAX_IMAGES = 10

/** Refuse to base64 anything larger: it has to survive as a JS string. */
private const val MAX_FILE_BYTES = 8 * 1024 * 1024

private suspend fun imageJson(
    context: Context,
    uri: Uri,
    request: NativeUiRequest?,
): String = withContext(Dispatchers.IO) {
    val options = request?.options ?: JSONObject()
    val maxSize = options.optInt("maxSize", DEFAULT_MAX_SIZE).coerceIn(64, 4096)
    val quality = options.optInt("quality", DEFAULT_QUALITY).coerceIn(10, 100)

    val bitmap = decodeScaled(context, uri, maxSize) ?: return@withContext "null"

    val output = ByteArrayOutputStream()
    bitmap.compress(Bitmap.CompressFormat.JPEG, quality, output)
    val bytes = output.toByteArray()

    val json = JSONObject().apply {
        put("dataUrl", "data:image/jpeg;base64," + Base64.encodeToString(bytes, Base64.NO_WRAP))
        put("width", bitmap.width)
        put("height", bitmap.height)
        put("sizeKb", Math.round(bytes.size / 1024f))
        put("name", displayName(context, uri) ?: "image.jpg")
    }
    bitmap.recycle()
    json.toString()
}

/** Two-pass decode, so a 12MP photo is never fully in memory. */
private fun decodeScaled(context: Context, uri: Uri, maxSize: Int): Bitmap? {
    val resolver = context.contentResolver

    val bounds = BitmapFactory.Options().apply { inJustDecodeBounds = true }
    resolver.openInputStream(uri)?.use { BitmapFactory.decodeStream(it, null, bounds) } ?: return null
    if (bounds.outWidth <= 0 || bounds.outHeight <= 0) return null

    var sample = 1
    val longEdge = maxOf(bounds.outWidth, bounds.outHeight)
    while (longEdge / (sample * 2) >= maxSize) sample *= 2

    val decoded = resolver.openInputStream(uri)?.use {
        BitmapFactory.decodeStream(it, null, BitmapFactory.Options().apply { inSampleSize = sample })
    } ?: return null

    val decodedLongEdge = maxOf(decoded.width, decoded.height)
    if (decodedLongEdge <= maxSize) return decoded

    val ratio = maxSize.toFloat() / decodedLongEdge
    val scaled = Bitmap.createScaledBitmap(
        decoded,
        Math.round(decoded.width * ratio),
        Math.round(decoded.height * ratio),
        true,
    )
    if (scaled !== decoded) decoded.recycle()
    return scaled
}

private suspend fun fileJson(
    context: Context,
    uri: Uri,
    request: NativeUiRequest?,
): String = withContext(Dispatchers.IO) {
    try {
        val bytes = context.contentResolver.openInputStream(uri)?.use { it.readBytes() }
            ?: return@withContext "null"

        if (bytes.size > MAX_FILE_BYTES) {
            return@withContext JSONObject()
                .put("error", "File is larger than ${MAX_FILE_BYTES / (1024 * 1024)}MB.")
                .put("size", bytes.size)
                .toString()
        }

        val name = displayName(context, uri) ?: "file"
        val mime = context.contentResolver.getType(uri) ?: guessMimeType(name)

        JSONObject().apply {
            put("name", name)
            put("mimeType", mime)
            put("size", bytes.size)
            put("dataUrl", "data:$mime;base64," + Base64.encodeToString(bytes, Base64.NO_WRAP))
            // Text formats are what page code actually wants to parse, so they
            // come decoded as well and save the page a base64 round trip.
            if (request?.options?.optBoolean("asText", false) == true || isTextual(mime)) {
                put("text", bytes.toString(Charsets.UTF_8))
            }
        }.toString()
    } catch (_: Exception) {
        "null"
    }
}

/** `text` or a `dataUrl`, whichever the page passed, as bytes to write out. */
private fun payloadBytes(options: JSONObject): ByteArray {
    val dataUrl = options.optString("dataUrl")
    if (dataUrl.isNotEmpty()) {
        val comma = dataUrl.indexOf(',')
        if (comma != -1) {
            return try {
                Base64.decode(dataUrl.substring(comma + 1), Base64.DEFAULT)
            } catch (_: Exception) {
                ByteArray(0)
            }
        }
    }
    return options.optString("text").toByteArray(Charsets.UTF_8)
}

/** Writes a page-supplied file into the cache so the share sheet can read it. */
private fun cacheFile(context: Context, file: JSONObject): Uri? = try {
    val name = file.optString("name").ifEmpty { "share.txt" }
    val target = File(File(context.cacheDir, "share").also { it.mkdirs() }, name)
    target.writeBytes(payloadBytes(file))
    FileProvider.getUriForFile(context, context.packageName + ".fileprovider", target)
} catch (_: Exception) {
    null
}

private fun displayName(context: Context, uri: Uri): String? = try {
    context.contentResolver
        .query(uri, arrayOf(OpenableColumns.DISPLAY_NAME), null, null, null)
        ?.use { cursor ->
            if (cursor.moveToFirst()) cursor.getString(0) else null
        } ?: uri.lastPathSegment
} catch (_: Exception) {
    uri.lastPathSegment
}

private fun isTextual(mime: String): Boolean =
    mime.startsWith("text/") ||
        mime == "application/json" ||
        mime == "application/xml" ||
        mime.endsWith("+json") ||
        mime.endsWith("+xml")

private fun guessMimeType(name: String): String = when (name.substringAfterLast('.', "").lowercase()) {
    "png" -> "image/png"
    "jpg", "jpeg" -> "image/jpeg"
    "webp" -> "image/webp"
    "gif" -> "image/gif"
    "pdf" -> "application/pdf"
    "json" -> "application/json"
    "csv" -> "text/csv"
    "txt" -> "text/plain"
    "html" -> "text/html"
    "zip" -> "application/zip"
    else -> "application/octet-stream"
}
