package {{PACKAGE}}

// ---------------------------------------------------------------------------
// Encrypted storage, emitted ONLY when the project declares the
// "secureStorage" capability.
//
// This is the only file that touches androidx.security, which is why the
// builder does not carry that library at all: the shared code reaches this by
// reflection (`Class.forName(packageName + ".SecureStoreSupport")`) and answers
// "unavailable" wherever it is absent.
// ---------------------------------------------------------------------------

import android.content.Context
import androidx.security.crypto.EncryptedSharedPreferences
import androidx.security.crypto.MasterKeys

@Suppress("unused") // Reached by reflection from the shared shell.
object SecureStoreSupport {

    private var prefs: android.content.SharedPreferences? = null

    private fun prefs(context: Context): android.content.SharedPreferences? {
        prefs?.let { return it }
        return try {
            // The 1.0.0 API: a key alias plus a file name. MasterKey.Builder
            // only exists in the 1.1.0 alphas, and an alpha has no business in
            // a shipped app.
            @Suppress("DEPRECATION")
            val alias = MasterKeys.getOrCreate(MasterKeys.AES256_GCM_SPEC)

            @Suppress("DEPRECATION")
            EncryptedSharedPreferences.create(
                "native_secure",
                alias,
                context,
                EncryptedSharedPreferences.PrefKeyEncryptionScheme.AES256_SIV,
                EncryptedSharedPreferences.PrefValueEncryptionScheme.AES256_GCM,
            ).also { prefs = it }
        } catch (_: Throwable) {
            // A broken keystore must not take the app down; the page is told
            // the value is unavailable instead.
            null
        }
    }

    @JvmStatic
    fun set(context: Context, key: String, value: String?): Boolean {
        val store = prefs(context) ?: return false
        store.edit().apply { if (value == null) remove(key) else putString(key, value) }.apply()
        return true
    }

    @JvmStatic
    fun get(context: Context, key: String): String? = prefs(context)?.getString(key, null)

    @JvmStatic
    fun remove(context: Context, key: String): Boolean {
        val store = prefs(context) ?: return false
        store.edit().remove(key).apply()
        return true
    }
}
